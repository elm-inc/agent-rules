# vLLM Qwen3-Coder-30B-A3B AWQ4bit 常駐 (ADR-0017。既定はオンデマンド起動 = ADR-0005)
# AGENT-14 で確立。docker run --restart unless-stopped からの置換え。
#
# install:
#   sudo cp templates/systemd/vllm-qwen-coder.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
#   # HUGGING_FACE_HUB_TOKEN を含む env ファイル準備 (mode 600 必須):
#   install -m 600 /dev/null /etc/vllm-qwen-coder.env
#   sudo tee /etc/vllm-qwen-coder.env > /dev/null <<EOF
#   HUGGING_FACE_HUB_TOKEN=$(cat ~/.hf_token)
#   EOF
#   sudo chmod 600 /etc/vllm-qwen-coder.env
#
#   # 既存 docker --restart コンテナを停止
#   docker stop vllm-qwen-coder && docker rm vllm-qwen-coder
#
#   # systemd 経由で起動
#   sudo systemctl enable --now vllm-qwen-coder
#   sudo systemctl status vllm-qwen-coder
#   journalctl -u vllm-qwen-coder -f   # ログ確認
#
# 詳細: docs/setup/local-llm.md の "systemd unit 化" セクション

[Unit]
Description=vLLM Qwen3-Coder-30B-A3B AWQ4bit (常駐モデル, ADR-0017)
Documentation=https://github.com/elm-inc/agent-rules/blob/main/docs/setup/local-llm.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple

# クラッシュ時は 30 秒待って再起動 (docker --restart unless-stopped 同等)
Restart=on-failure
RestartSec=30

# vLLM の初回起動は重い (モデルロードに 30-60 秒、warmup 含めて 90 秒程度)
TimeoutStartSec=600
TimeoutStopSec=60

# elmo として実行 (docker グループ所属が前提)
User=elmo
Group=elmo

# HUGGING_FACE_HUB_TOKEN を 600 権限ファイルから読込 (inline 漏洩防止)
EnvironmentFile=/etc/vllm-qwen-coder.env

# 既存コンテナがあれば事前に掃除 (`-` 接頭で失敗を許容)
ExecStartPre=-/usr/bin/docker stop vllm-qwen-coder
ExecStartPre=-/usr/bin/docker rm vllm-qwen-coder

# HF cache は AGENT-16 移行後の統一パス。オンデマンド (ensure-vllm.sh) と同一にし二重 DL を防ぐ。
# AGENT-16 未移行マシンのみ -v を /home/elmo/models に sed で戻す。
ExecStart=/usr/bin/docker run --rm \
  --name vllm-qwen-coder \
  --gpus all --ipc=host \
  -p 8000:8000 \
  -v /home/elmo/.cache/huggingface:/root/.cache/huggingface \
  -e HUGGING_FACE_HUB_TOKEN \
  -e HF_HUB_ENABLE_HF_TRANSFER=1 \
  -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
  vllm/vllm-openai:latest \
  --model cyankiwi/Qwen3-Coder-30B-A3B-Instruct-AWQ-4bit \
  --revision 4bd30395b72ea6045edd04806c4fea448d4467b3 \
  --max-model-len 32768 \
  --gpu-memory-utilization 0.88 \
  --enforce-eager \
  --served-model-name qwen-coder

ExecStop=/usr/bin/docker stop -t 30 vllm-qwen-coder

[Install]
WantedBy=multi-user.target
