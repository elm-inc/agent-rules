{
  "$schema": "machine-usable design tokens. Inject directly into Tailwind config / CSS variables / inline styles. Keep in sync with dna.md.",
  "name": "<profile-name>",
  "color": {
    "bg": "#______",
    "surface": "#______",
    "ink": "#______",
    "accent": "#______",
    "accent2": "#______",
    "muted": "#______"
  },
  "font": {
    "heading": "<heading typeface>",
    "body": "<body typeface>",
    "mono": "<mono typeface, optional>"
  },
  "scale": {
    "base": "16px",
    "ratio": 1.25
  },
  "radius": {
    "sm": "0px",
    "md": "0px",
    "lg": "0px"
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96],
  "motion": {
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "duration": "180ms"
  },
  "forbid": {
    "gradients": ["blue-to-purple", "indigo-to-violet"],
    "fonts": ["Inter (as unexamined default)", "system-ui (as unexamined default)"],
    "effects": ["backdrop-blur / glassmorphism", "emoji-as-icon"]
  }
}
