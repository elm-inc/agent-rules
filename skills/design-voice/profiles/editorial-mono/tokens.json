{
  "$schema": "machine-usable design tokens. Inject directly into Tailwind config / CSS variables / inline styles. Keep in sync with dna.md.",
  "name": "editorial-mono",
  "color": {
    "bg": "#f4efe6",
    "surface": "#ffffff",
    "ink": "#1a1a1a",
    "accent": "#c1440e",
    "accent2": "#2d4a3e",
    "muted": "#8a8275"
  },
  "font": {
    "heading": "\"GT Sectra\", \"Noto Serif JP\", serif",
    "body": "\"Söhne\", \"Inter Tight\", \"Noto Sans JP\", sans-serif",
    "mono": "\"Söhne Mono\", ui-monospace, monospace"
  },
  "scale": {
    "base": "17px",
    "ratio": 1.333,
    "lineHeight": 1.65
  },
  "radius": {
    "sm": "0px",
    "md": "0px",
    "lg": "0px"
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96],
  "measure": "66ch",
  "motion": {
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "duration": "180ms"
  },
  "forbid": {
    "gradients": ["blue-to-purple", "indigo-to-violet", "any background gradient"],
    "fonts": ["all-sans (headings must be serif)", "Inter as default", "system-ui as default"],
    "effects": ["drop-shadow on surfaces (use 1px rules)", "backdrop-blur / glassmorphism", "emoji-as-icon", "centered hero"]
  }
}
