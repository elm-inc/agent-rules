# ~/.newrelic/<profile>.env  (例: ~/.newrelic/acme-prod.env)
# 必ず chmod 600。このファイルだけが鍵の出所 (ADR-0008 §C/§F)。
# profile 名は顧客名直書きを避け、非識別的にするのが望ましい (ADR §D)。

# User API Key (NerdGraph 用, NRAK-* / EU は EU で始まる)
NEW_RELIC_API_KEY=NRAK-xxxxxxxxxxxxxxxxxxxx

# 対象アカウント ID (数値)
NEW_RELIC_ACCOUNT_ID=1234567

# データセンター: us (既定) | eu。鍵の prefix と整合していること
NEW_RELIC_REGION=us

# FedRAMP/HIPAA 等で公式 MCP を使えないテナントは false にする (init が .mcp.json を作らない)
# NEW_RELIC_MCP_ALLOWED=false
